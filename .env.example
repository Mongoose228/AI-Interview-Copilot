DEEPL_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
NETWORK_CONNECT_TIMEOUT=5
NETWORK_READ_TIMEOUT=30
MAX_LLM_TOKENS=250

WHISPER_MODEL=small.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=4

AUDIO_DEVICE=
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_MS=30

VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_SILENCE_MS=600
VAD_SPEECH_PAD_MS=150
VAD_MAX_PHRASE_SECONDS=12

# Debounce delay before sending accumulated speech to LLM (seconds).
# Higher = better question merging, slower response. Lower = faster but may split questions.
LLM_DEBOUNCE_DELAY_S=1.2

# Translation: "none", "deepl", or "nllb"
TRANSLATION_BACKEND=none
NLLB_MODEL=facebook/nllb-200-distilled-600M

# Leave empty to use %APPDATA%/interview_copilot/context (recommended)
CONTEXT_DIR=
LOG_OBFUSCATION_ENABLED=true
LOG_LEVEL=INFO
