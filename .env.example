DEEPL_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
NETWORK_CONNECT_TIMEOUT=5
NETWORK_READ_TIMEOUT=30
MAX_LLM_TOKENS=250

# STT: whisper = local default (recommended). deepgram/groq/soniox = optional paid later.
STT_BACKEND=whisper
STT_FALLBACK=whisper
STT_KEYTERMS_FROM_PROFILE=true
STT_DUAL_PATH_ENABLED=true
STT_PROVISIONAL_MODEL=tiny.en

# Optional paid cloud STT — leave empty while using local Whisper
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-preview

WHISPER_MODEL=base.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=4

AUDIO_DEVICE=
AUDIO_MIC_DEVICE=
AUDIO_DUAL_CHANNEL=false
# When mic VAD hears you, ignore loopback (speaker echo) for STT/LLM
AUDIO_SUPPRESS_LOOPBACK_WHILE_MIC=true
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_MS=20

DSP_ENABLED=true
DSP_MONO_MODE=energy
DSP_NORMALIZE_ENABLED=true
DSP_DENOISE_ENABLED=true
DSP_TARGET_PEAK=0.9

VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_SILENCE_MS=350
VAD_SPEECH_PAD_MS=150
VAD_MAX_PHRASE_SECONDS=12

# Debounce delay before sending accumulated speech to LLM (seconds).
LLM_DEBOUNCE_DELAY_S=0.25
# Max seconds to wait for VAD speech-end before sending to LLM anyway
# (constant background noise can keep VAD "speaking").
LLM_MAX_WAIT_FOR_SPEECH_END_S=4.0

PARTIAL_TRANSCRIPTION_ENABLED=true
PARTIAL_TRANSCRIPTION_INTERVAL_MS=800
PARTIAL_TRANSCRIPTION_MIN_AUDIO_MS=700

# Translation: "none", "deepl", or "nllb"
TRANSLATION_BACKEND=none
NLLB_MODEL=facebook/nllb-200-distilled-600M

# Leave empty to use %APPDATA%/interview_copilot/context (recommended)
CONTEXT_DIR=
LOG_OBFUSCATION_ENABLED=true
LOG_LEVEL=INFO
