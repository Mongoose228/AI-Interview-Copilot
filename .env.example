DEEPL_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
NETWORK_CONNECT_TIMEOUT=5
NETWORK_READ_TIMEOUT=30

WHISPER_MODEL=small.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=1

AUDIO_DEVICE=
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_MS=30
AUDIO_BACKEND=soundcard

VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_SILENCE_MS=600
VAD_SPEECH_PAD_MS=150
VAD_MAX_PHRASE_SECONDS=30

# Translation: "none", "deepl", or "nllb"
TRANSLATION_BACKEND=none
NLLB_MODEL=facebook/nllb-200-distilled-600M

CONTEXT_DIR=./context
PRIVACY_MODE=true
TEXT_LOGGING_ENABLED=false
LOG_LEVEL=INFO
